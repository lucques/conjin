#!/usr/bin/env bash

set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repository_dir="$(cd -- "${script_dir}/../.." && pwd)"
project_dir="$(cd -- "${repository_dir}/../.." && pwd)"
eskuel_current_dir="${ESKUEL_CURRENT_DIR:-${project_dir}/priv/eskuel-suite/dist}"
tau_interface_dir="${TAU_INTERFACE_DIR:-${project_dir}/priv/tau-prolog-interface/dist}"
work_dir="$(mktemp -d "${TMPDIR:-/tmp}/conjin-private-packages.XXXXXX")"
trap 'rm -rf -- "${work_dir}"' EXIT

# Create minimal packages from the browser files served by Conjin.
mkdir -p "${work_dir}/eskuel/package/shared" \
    "${work_dir}/tau/package"

# Keep eskuel's runtime assets but omit source maps, which Conjin does not serve.
find "${eskuel_current_dir}" -maxdepth 1 -type f \
    ! -name '*.map' ! -name 'eskuel-suite.js' \
    -exec cp -- '{}' "${work_dir}/eskuel/package/shared/" \;
cp -- "${eskuel_current_dir}/eskuel-suite.js" "${work_dir}/eskuel/package/"
cp -- "${tau_interface_dir}/tau-prolog-interface.js" "${work_dir}/tau/package/"

# Define npm packages with only the generated browser assets.
cat > "${work_dir}/eskuel/package/package.json" <<'JSON'
{
  "name": "@conjin/eskuel-suite-assets",
  "version": "1.3.4",
  "private": true,
  "files": ["shared", "eskuel-suite.js"]
}
JSON

cat > "${work_dir}/tau/package/package.json" <<'JSON'
{
  "name": "@conjin/tau-prolog-interface-assets",
  "version": "0.0.1",
  "private": true,
  "files": ["tau-prolog-interface.js"]
}
JSON

rm -f -- "${script_dir}/conjin-eskuel-suite-assets-1.3.4.tgz" \
    "${script_dir}/conjin-tau-prolog-interface-assets-0.0.1.tgz"

# Pack deterministic local npm tarballs consumed by package-lock.json.
(cd "${work_dir}/eskuel/package" && npm pack --quiet --pack-destination "${script_dir}")
(cd "${work_dir}/tau/package" && npm pack --quiet --pack-destination "${script_dir}")

echo "Rebuilt private npm package tarballs. Run npm install --package-lock-only to refresh the lockfile."
