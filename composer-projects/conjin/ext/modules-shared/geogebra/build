#!/usr/bin/env bash

set -euo pipefail

version="5-4-925-3"
expected_sha256="e4daa512834f6d3cf8c64a6fe28ced8dd4d2d25e687b3d8928c78d03c5f770b6"
url="https://download.geogebra.org/installers/5.4/geogebra-math-apps-bundle-${version}.zip"
script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
archive="$(mktemp "${TMPDIR:-/tmp}/geogebra.XXXXXX.zip")"
extract_dir="$(mktemp -d "${TMPDIR:-/tmp}/geogebra.XXXXXX")"
trap 'rm -rf -- "${archive}" "${extract_dir}"' EXIT

curl --fail --location --silent --show-error --output "${archive}" "${url}"
printf '%s  %s\n' "${expected_sha256}" "${archive}" | sha256sum --check --status
unzip -q "${archive}" -d "${extract_dir}"
test -f "${extract_dir}/GeoGebra/deployggb.js"

rm -rf -- "${script_dir}/res"
mv -- "${extract_dir}/GeoGebra" "${script_dir}/res"
