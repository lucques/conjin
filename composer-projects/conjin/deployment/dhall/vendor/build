#!/usr/bin/env bash

set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
work_dir="$(mktemp -d "${TMPDIR:-/tmp}/conjin-dhall.XXXXXX")"
trap 'rm -rf -- "${work_dir}"' EXIT

download_and_verify() {
    local url="$1"
    local expected_sha256="$2"
    local archive="$3"

    curl --fail --location --silent --show-error --output "${archive}" "${url}"
    printf '%s  %s\n' "${expected_sha256}" "${archive}" | sha256sum --check --status
}

dhall_lang_commit="fd057db9b3f89de44cdc77d9669e958b04ed416a"
dhall_compose_commit="f077072175ee1501e12efc9fd37963ae043596ab"

download_and_verify \
    "https://codeload.github.com/dhall-lang/dhall-lang/tar.gz/${dhall_lang_commit}" \
    "d381d6463fe8616354b620a845fed1e24f6a4c10628e0ecad7a5e7554d253186" \
    "${work_dir}/dhall-lang.tar.gz"
download_and_verify \
    "https://codeload.github.com/lucques/dhall-docker-compose/tar.gz/${dhall_compose_commit}" \
    "91218a26e16fd7300de2bf65c37f27d98051f47f2f7234f491bf8b61896aa839" \
    "${work_dir}/dhall-docker-compose.tar.gz"

tar -xzf "${work_dir}/dhall-lang.tar.gz" -C "${work_dir}"
tar -xzf "${work_dir}/dhall-docker-compose.tar.gz" -C "${work_dir}"

(
    cd -- "${work_dir}/dhall-lang-${dhall_lang_commit}/Prelude"
    dhall resolve --file package.dhall > package_resolved.dhall
)
(
    cd -- "${work_dir}/dhall-docker-compose-${dhall_compose_commit}/compose/v3"
    dhall resolve --file package.dhall > package_resolved.dhall
)

rm -rf -- "${script_dir}/dhall-lang-${dhall_lang_commit}" \
    "${script_dir}/dhall-docker-compose-${dhall_compose_commit}"
mv -- "${work_dir}/dhall-lang-${dhall_lang_commit}" "${script_dir}/"
mv -- "${work_dir}/dhall-docker-compose-${dhall_compose_commit}" "${script_dir}/"
